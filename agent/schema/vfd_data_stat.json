{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DaYu VFD Data Stat",
  "description": "Per-process HDF5 VFD tracker statistics. Filename pattern: <pid>-vfd_data_stat.json",
  "type": "array",
  "items": {
    "type": "object",
    "description": "Each item is keyed by 'file-N' containing stats for one HDF5 file",
    "additionalProperties": {
      "type": "object",
      "required": ["file_name", "task_name", "access_type"],
      "properties": {
        "file_name": {"type": "string"},
        "task_name": {"type": "string", "description": "Format: <task_base>-<pid>"},
        "open_time(us)": {"type": "integer", "description": "File open timestamp in microseconds"},
        "close_time(us)": {"type": "integer", "description": "File close timestamp in microseconds"},
        "file_read_cnt": {"type": "integer"},
        "file_write_cnt": {"type": "integer"},
        "access_type": {"type": "string", "enum": ["read_only", "write_only", "read_write"]},
        "io_bytes": {"type": "integer"},
        "data": {
          "type": "array",
          "description": "Per-dataset data access breakdown by HDF5 memory type",
          "items": {"type": "object"}
        },
        "metadata": {
          "type": "array",
          "description": "Per-dataset metadata access breakdown",
          "items": {"type": "object"}
        }
      }
    }
  }
}
